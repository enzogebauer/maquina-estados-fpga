set_global_assignment -name EDA_TEST_BENCH_RUN_SIM_FOR "10 us" -section_id tb_morse
set_global_assignment -name EDA_TEST_BENCH_FILE morse_pkg.vhd -section_id tb_morse
set_global_assignment -name EDA_TEST_BENCH_FILE morse_codificador.vhd -section_id tb_morse
